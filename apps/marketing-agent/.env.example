# ---------------------------------------------------------------------------
# SkillSplore marketing-agent — own configuration, own secrets.
# This service NEVER reads the marketplace's (apps/api's) .env, and the
# marketplace never reads this one. Copy to .env and adjust.
# ---------------------------------------------------------------------------

# development | demo | production. Production refuses to boot with demo/mock
# settings or weak secrets — see src/config/env.ts.
APP_ENV=development
APP_URL=http://localhost:4100
API_PORT=4100
# Origin of the dashboard SPA (the Vite dev server in development).
DASHBOARD_ORIGIN=http://localhost:5183

# Own PostgreSQL database — a different database from the marketplace's.
DATABASE_URL=postgresql://skillsplore:skillsplore@localhost:5432/skillsplore_marketing?schema=public
# Set to true for managed Postgres hosts that require TLS (e.g. Render).
# Prisma negotiates TLS on its own regardless of this flag; it only affects
# the raw pg.Pool behind the session store (src/app.ts). Leave false for a
# plain self-hosted/docker-compose Postgres with no TLS configured.
DATABASE_SSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev-only-insecure-session-secret-change-me
# Reversible key for encrypting LinkedIn OAuth tokens at rest (AES-256-GCM).
# Generate the same way as SESSION_SECRET, with a DIFFERENT value.
TOKEN_ENCRYPTION_KEY=dev-only-insecure-token-key-change-me-too
FORCE_SECURE_COOKIES=0

# First-boot bootstrap for the single founder/admin account (see prisma/seed.ts).
# Leave unset for a printed demo-only credential in development.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- LinkedIn (draft-only until these are set AND LINKEDIN_PUBLISHING_ENABLED=true) ---
# See docs/marketing-agent/LINKEDIN_SETUP.md. Never commit real values here.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4100/api/linkedin/oauth/callback
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_API_VERSION=202405
LINKEDIN_PUBLISHING_ENABLED=false
# Demo/test double for the LinkedIn API. Production refuses to start if this
# is true (§35) — real and mock publication can never be mixed up.
MOCK_LINKEDIN_API=true

# --- Content generation provider ---
# template | anthropic | openai_compatible | ollama
# "template" needs no network access and no API key at all.
CONTENT_AI_PROVIDER=template
CONTENT_AI_API_KEY=
CONTENT_AI_MODEL=
OPENAI_COMPATIBLE_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434

# --- Image generation for post creative ---
# none | openai_compatible | automatic1111
# Configured separately from the text provider — you can run local Stable
# Diffusion for images and no AI at all for copy, or any other combination.
# "none" (the default) disables the Generate button; everything else still works.
#   openai_compatible -> IMAGE_AI_BASE_URL=https://api.openai.com/v1 (+ IMAGE_AI_API_KEY)
#   automatic1111     -> IMAGE_AI_BASE_URL=http://localhost:7860 (no key, fully self-hosted)
IMAGE_AI_PROVIDER=none
IMAGE_AI_BASE_URL=
IMAGE_AI_API_KEY=
# openai_compatible: a model name (e.g. gpt-image-1).
# automatic1111: a checkpoint name to switch to, or blank to use the current one.
IMAGE_AI_MODEL=
IMAGE_AI_SIZE=1024x1024

DEFAULT_TIMEZONE=Pacific/Auckland
# Only ever applies to already-approved content at its scheduled time.
AUTO_PUBLISH_APPROVED_POSTS=false

# --- Object storage for the media library (local disk or S3-compatible) ---
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_DIR=./storage-data
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=skillsplore-marketing
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Launch configuration (§1) — do not advertise beyond this ---
MARKETPLACE_LAUNCH_COUNTRY=NZ
MARKETPLACE_LAUNCH_CITY=Auckland
MARKETPLACE_LAUNCH_CATEGORY=Tutoring
MARKETPLACE_LAUNCH_STAGE=Pre-launch

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
LOGIN_LOCKOUT_THRESHOLD=8
LOGIN_LOCKOUT_MINUTES=15
